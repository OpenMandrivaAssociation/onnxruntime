diff --git a/cmake/CMakeLists.txt b/cmake/CMakeLists.txt
--- a/cmake/CMakeLists.txt
+++ b/cmake/CMakeLists.txt
@@ -1213,6 +1213,18 @@
           target_compile_options(${target_name} PRIVATE "$<$<COMPILE_LANGUAGE:CXX>:-Wno-strict-aliasing>")
       endif()
     endif()
+    # COMPILE_WARNING_AS_ERROR appends -Werror after every other option, so an
+    # earlier -Wno-error= flag cannot carve an exception. Clang 23 fails the
+    # 1.28 sources on unused locals that upstream still ships. Protobuf 36
+    # nodiscard sites are fixed in the source instead of silencing
+    # -Wunused-result.
+    if (CMAKE_CXX_COMPILER_ID MATCHES "Clang|GNU|AppleClang")
+      set_target_properties(${target_name} PROPERTIES COMPILE_WARNING_AS_ERROR OFF)
+      target_compile_options(${target_name} PRIVATE
+        "$<$<COMPILE_LANGUAGE:CXX,C>:-Werror>"
+        "$<$<COMPILE_LANGUAGE:CXX,C>:-Wno-error=unused-variable>"
+        "$<$<COMPILE_LANGUAGE:CXX,C>:-Wno-error=unused-but-set-variable>")
+    endif()
 endfunction()
 
 function(onnxruntime_set_source_file_properties target_name)
