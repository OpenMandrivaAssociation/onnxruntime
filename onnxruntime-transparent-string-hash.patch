 #else  // DISABLE_ABSEIL
 
+// absl hash maps accept std::string_view lookups on std::string keys.
+// std::hash<std::string> is not transparent, so libstdc++ rejects
+// map.find(string_view). Hash the same bytes as std::hash<std::string>.
+struct TransparentStringHash {
+  using is_transparent = void;
+  size_t operator()(std::string_view value) const noexcept {
+    return std::hash<std::string_view>{}(value);
+  }
+};
+
+template <typename Key, typename = void>
+struct InlinedHash : std::hash<Key> {};
+
+template <typename Key>
+struct InlinedHash<Key, std::enable_if_t<std::is_same_v<Key, std::string>>>
+    : TransparentStringHash {};
+
+template <typename Key, typename = void>
+struct InlinedEq : std::equal_to<Key> {};
+
+template <typename Key>
+struct InlinedEq<Key, std::enable_if_t<std::is_same_v<Key, std::string>>>
+    : std::equal_to<void> {};
+
 template <typename T, typename Allocator>
 class InlinedHashSet : public std::unordered_set<T,
-                                                 std::hash<T>,
